@startuml CognitradeArchitectureCNSimple
title Cognitrade 当前架构（中文易读版）

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultFontName "Microsoft YaHei"
skinparam ArrowColor #53657A
skinparam PackageBorderColor #53657A
skinparam ComponentBorderColor #53657A
skinparam DatabaseBorderColor #53657A
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B7950B
skinparam nodesep 45
skinparam ranksep 45

actor "研究者" as user
rectangle "React 前端\n研究 / 基金 / 行情 / /strategies / 模拟盘" as frontend
rectangle "Nginx + FastAPI\nBearer 鉴权 / owner 隔离 / 持久化幂等 / CORS / SSE" as api

user --> frontend : 提交、查看、治理
frontend --> api : HTTPS + JSON

package "① 研究与证据主线" as researchLane {
  rectangle "Agent OS\nIntake → Planner → ExecutionGraph\n重试 / 恢复 / ChildTurn" as agent
  rectangle "DomainPack\nFinance：个股 / 基金 / 行业 / 组合 / UZI\nLegal：合同审查" as packs
  rectangle "真实数据与模型\nAkShare / TuShare / eFinance / BaoStock / HTTP\nOpenAI 或兼容模型" as providers
  rectangle "ArtifactBoard\n来源 / 数据日期 / 质量 / data_gap / 报告" as artifacts

  agent --> packs
  packs --> providers
  providers --> artifacts
}

package "② 基金报告策略主线" as strategyLane {
  rectangle "策略草稿与不可变版本\n固定权重 / 阈值 / MA / 费率 / 模型与 UZI Pin" as version
  rectangle "基金 Assignment\n基金 + fund_only / holdings_portfolio\n生效版本 + 日调度" as assignment
  rectangle "Point-in-time 日报\n当时已公开基金报告\n+ top 5/10/20 canonical UZI 个股子报告" as report
  rectangle "确定性复合信号\n基金本体 + 持仓 UZI + 结构质量\nALLOW_BUY / WATCH / AVOID / BLOCKED" as signal
  rectangle "严格版本回测（Hikyuu）\n基金本体 / 持仓组合\n股票 / ETF·LOF / 场外基金 NAV" as backtest
  rectangle "治理与受控执行\n机器验证 → 人工 Verified → 人工 Promoted\n精确 lineage 才能提交策略模拟单" as governedExecution

  version --> assignment
  assignment --> report : 每日 / 补跑 / 失败重试
  report --> signal
  signal --> backtest
  backtest --> governedExecution
}

package "③ 独立金融工具" as financeLane {
  rectangle "行情聚合\n证券解析 / 报价 / K 线 / 市场快照" as market
  rectangle "通用模拟盘（VeighNa）\n账户 / 市价与限价单 / 冻结资金\n费用 / FIFO / T+1" as paper
  rectangle "旧单股票技术回测\n/backtests/** 仅内部诊断\n新前端不再调用" as legacy

  market --> paper : 服务端取价与撮合
  market --> legacy : 兼容 K 线输入
}

api --> agent : /api/v1 研究运行
api --> version : /api/v2/finance 策略合同
api --> market : /api/v2/finance 金融工具

agent -[hidden]right-> version
version -[hidden]right-> market

package "持久化与保留" as storageLane {
  database "Workspace\nruns / cache / memory\nAgent 事件与 Artifact" as workspace
  database "SQLite / PostgreSQL\n策略 / 版本 / 日报 / 信号\n回测 / 验证 / lineage" as strategyDb
  database "内容寻址对象存储\n报告 / 快照 / 回测曲线\n被引用对象永久保护" as objectStore
  database "paper_trading.sqlite3\n资金 / 持仓 / 委托 / 成交" as paperDb
}

artifacts --> workspace
governedExecution --> strategyDb
report --> objectStore
backtest --> objectStore
paper --> paperDb

workspace -[hidden]right-> strategyDb
strategyDb -[hidden]right-> objectStore
objectStore -[hidden]right-> paperDb

legend bottom
  阅读顺序：顶部入口 → 三条独立泳道 → 底部持久化
  泳道之间不画实现级长连线；详细调用时序见 current-architecture.md
endlegend

@enduml
