PROVIDER_NAME=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=xhigh
OPENAI_SERVICE_TIER=default
OPENAI_DISABLE_RESPONSE_STORAGE=true
TUSHARE_TOKEN=
MX_APIKEY=
UZI_DDG_TIMEOUT=10
# Concurrent holdings share exact full-market/quarterly provider responses.
# Waiters stop blocking if the leading real request never returns; no value is
# fabricated and the affected UZI field remains a data gap.
UZI_SHARED_SOURCE_WAIT_TIMEOUT_SECONDS=1200
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=research_evidence
PROVIDER_PROBE_TIMEOUT_SECONDS=1.0
# BaoStock 0.9.3 can spin forever when its TCP peer closes mid-response.
# This bounds connect/read time without disabling the UZI BaoStock fallback.
COGNITRADE_BAOSTOCK_SOCKET_TIMEOUT_SECONDS=15
COGNITRADE_PROVIDERS_MARKET=
COGNITRADE_PROVIDERS_FUNDAMENTAL=
COGNITRADE_PROVIDERS_NOTICE=
COGNITRADE_PROVIDERS_SECTOR=
COGNITRADE_PROVIDERS_CAPITAL_FLOW=
COGNITRADE_PROVIDERS_SENTIMENT=
COGNITRADE_PROVIDERS_LHB=
COGNITRADE_PROVIDERS_EVENTS=
COGNITRADE_PROVIDERS_POLICY=
COGNITRADE_PROVIDERS_KLINE=
COGNITRADE_PROVIDERS_MACRO=
COGNITRADE_PROVIDERS_PEERS=
COGNITRADE_PROVIDERS_CHAIN=
COGNITRADE_PROVIDERS_RESEARCH=
COGNITRADE_PROVIDERS_INDUSTRY=
COGNITRADE_PROVIDERS_MATERIALS=
COGNITRADE_PROVIDERS_FUTURES=
COGNITRADE_PROVIDERS_VALUATION=
COGNITRADE_PROVIDERS_GOVERNANCE=
COGNITRADE_PROVIDERS_MOAT=
COGNITRADE_PROVIDERS_TRAP=
COGNITRADE_PROVIDERS_CONTESTS=
COGNITRADE_PROVIDERS_FUND_HOLDERS=
COGNITRADE_PROVIDERS_SIMILAR_STOCKS=
COGNITRADE_PROVIDERS_FUND=
# Sensitive authenticated sources are disabled by default. Enabling the global
# switch alone is insufficient: add each source to the allowlist and provide
# its credential through the environment. Never commit a real Cookie value.
COGNITRADE_SENSITIVE_SOURCES_ENABLED=false
# UZI 3.9.4 browser parity set (enable only after reviewing deployment policy):
# xueqiu,em_data,cninfo,stats_gov,pbc,gov_cn,csrc,miit,ths_f10,100ppi,shfe,ddgs
COGNITRADE_SENSITIVE_SOURCE_ALLOWLIST=
COGNITRADE_XUEQIU_COOKIE=
# Optional browser fallback for explicitly allowlisted sources. Keep disabled
# unless the deployment image includes Chromium and the source is permitted.
COGNITRADE_BROWSER_SOURCES_ENABLED=false
LLM_REQUEST_TIMEOUT_SECONDS=25
# Compatibility fallback for UZI calls that do not belong to a report profile.
UZI_LLM_REQUEST_TIMEOUT_SECONDS=480
# Report-stage budgets follow prompt size. Lite fails fast, while Deep gets
# enough time for its larger frozen-evidence payload.
UZI_LLM_LITE_REQUEST_TIMEOUT_SECONDS=240
UZI_LLM_MEDIUM_REQUEST_TIMEOUT_SECONDS=600
UZI_LLM_DEEP_REQUEST_TIMEOUT_SECONDS=900
# Buy-zone prompts are small; do not let one provider tail occupy a slot for
# the full Deep budget.
UZI_LLM_BUY_ZONE_REQUEST_TIMEOUT_SECONDS=300
# Keep the process-wide UZI request ceiling aligned with the default maximum
# of two concurrently running holding reports.
UZI_LLM_MAX_CONCURRENCY=2
# Retry only transient provider overloads (502/503/504) with exponential
# backoff; request timeouts and invalid model content still fail explicitly.
UZI_LLM_TRANSIENT_RETRIES=6
UZI_LLM_RETRY_BASE_SECONDS=2
UZI_LLM_RETRY_MAX_SECONDS=60
ARTIFACTS_RETENTION_DAYS=30
MAX_ARTIFACTS_SIZE_MB=1024
RUN_TIMEOUT_SECONDS=120
COGNITRADE_FUND_HOLDING_REPORT_CONCURRENCY=2

# FastAPI transport. Generate a strong token before starting the API.
COGNITRADE_API_TOKEN=
# Local-only fallback: valid without a token only when HOST is loopback.
COGNITRADE_API_ALLOW_UNAUTHENTICATED=false
COGNITRADE_API_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
COGNITRADE_API_HOST=127.0.0.1
COGNITRADE_API_PORT=8000
COGNITRADE_API_LOG_LEVEL=info
COGNITRADE_API_RELOAD=false
COGNITRADE_API_SSE_POLL_SECONDS=0.25
COGNITRADE_API_SSE_HEARTBEAT_SECONDS=15
COGNITRADE_PAPER_ENFORCE_MARKET_HOURS=true

# Strategy/report domain persistence. SQLite is the single-instance default.
# Production PostgreSQL example:
# postgresql+psycopg://cognitrade:password@postgres.example.com:5432/cognitrade
COGNITRADE_DATABASE_URL=sqlite:////app/workspace/cognitrade.sqlite3
# Production is migration-managed. The container entrypoint runs Alembic first.
COGNITRADE_DATABASE_AUTO_BOOTSTRAP=false
# Must be a shared persistent POSIX path when multiple API instances are used.
COGNITRADE_OBJECT_STORE_ROOT=/app/workspace/strategy_objects

# Container deployment. Keep loopback binding unless a firewall/TLS reverse proxy
# protects the host. Runtime data is stored in the named volume below.
COGNITRADE_WEB_HOST=127.0.0.1
COGNITRADE_WEB_PORT=8080
COGNITRADE_WORKSPACE_VOLUME=cognitrade_workspace

# Optional image overrides for private registries or Docker Hub mirrors.
COGNITRADE_PYTHON_IMAGE=python:3.11-slim-bookworm
COGNITRADE_NODE_IMAGE=node:22-alpine
COGNITRADE_NGINX_IMAGE=nginx:alpine
# Package mirrors used only while building images. Keep official defaults or
# replace them with an operator-approved reachable mirror.
COGNITRADE_PIP_INDEX_URL=https://pypi.org/simple
COGNITRADE_NPM_REGISTRY=https://registry.npmjs.org
COGNITRADE_DEBIAN_MIRROR=http://deb.debian.org/debian
COGNITRADE_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# UZI global peer comparison is enabled by default (Yahoo public endpoints).
# Set true only when an operator explicitly wants to disable this capability.
COGNITRADE_UZI_DISABLE_GLOBAL_PEERS=false
