{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "methodology_version",
    "profile",
    "results",
    "confidence",
    "risk_flags"
  ],
  "properties": {
    "methodology_version": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "results": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_status": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
