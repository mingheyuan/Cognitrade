{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["methodology_version", "candidate_count", "candidates", "recommendations", "selection_policy", "quality_status", "data_gap", "generated_at"],
  "properties": {
    "methodology_version": {"type": "string"},
    "fund_category": {"type": ["string", "null"]},
    "investment_cycle": {"type": ["string", "null"]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "selection_policy": {"type": "object"},
    "quality_status": {"enum": ["available", "degraded", "data_gap"]},
    "data_gap": {"type": "array", "items": {"type": "string"}},
    "provider_errors": {"type": "array", "items": {"type": "object"}},
    "generated_at": {"type": "string"}
  }
}
