{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "query",
    "symbols"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "symbols": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fund_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fund_category": {
      "type": ["string", "null"]
    },
    "portfolio_holdings": {
      "type": "array",
      "items": {"type": "object"}
    },
    "benchmark_return": {
      "type": ["number", "null"]
    },
    "rebalance_targets": {
      "type": ["object", "null"]
    },
    "drift_threshold": {
      "type": ["number", "null"]
    },
    "fee_model": {
      "type": ["object", "null"]
    },
    "asset_class_targets": {
      "type": ["object", "null"]
    },
    "requested_methods": {
      "type": "array",
      "items": {"type": "string"}
    },
    "method_assumptions": {
      "type": ["object", "null"]
    },
    "holding_context": {
      "type": ["object", "null"],
      "properties": {
        "parent_batch_id": {"type": "string"},
        "source_fund_run_id": {"type": "string"},
        "source_fund_artifact_id": {"type": "string"},
        "fund_code": {"type": "string"},
        "fund_name": {"type": "string"},
        "fund_type": {"type": ["string", "null"]},
        "holding_rank": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "security_name": {"type": "string"},
        "fund_weight_pct": {"type": ["number", "null"]},
        "target_security_weight_pct": {"type": ["number", "null"]},
        "holding_source": {"enum": ["direct_equity_disclosure", "target_etf_lookthrough"]},
        "disclosure_date": {"type": ["string", "null"]},
        "disclosure_age_days": {"type": ["integer", "null"], "minimum": 0},
        "stale_level": {"enum": ["current", "warning", "confirmation_required", "unknown"]},
        "disclaimer": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
