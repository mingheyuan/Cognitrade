{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "holding": {
      "type": "object", "x-business-extensible": true,
      "properties": {
        "ticker": {"type": "string"}, "symbol": {"type": "string"}, "name": {"type": "string"},
        "weight": {"type": "number"}, "normalized_weight": {"type": "number"},
        "return_pct": {"type": ["number", "null"]}, "contribution_pct": {"type": ["number", "null"]},
        "status": {"type": "string"}, "industry": {"type": "string"}, "market": {"type": "string"},
        "asset_class": {"type": "string"}, "value": {"type": "number"}, "market_value": {"type": "number"},
        "quantity": {"type": "number"}, "price": {"type": "number"}
      }
    },
    "group": {
      "type": "object", "x-business-extensible": true,
      "properties": {
        "industry": {"type": "string"}, "market": {"type": "string"}, "weight": {"type": "number"},
        "observed_weight": {"type": "number"}, "contribution_pct": {"type": "number"},
        "missing_tickers": {"type": "array", "items": {"type": "string"}}, "status": {"type": "string"}
      }
    }
  },
  "type": "object",
  "required": ["methodology_version", "method", "quality_status", "data_gap", "assumption_flags", "generated_at"],
  "properties": {
    "methodology_version": {"type": "string"}, "method": {"const": "returns_attribution"},
    "holdings": {"type": "array", "items": {"$ref": "#/$defs/holding"}},
    "observed_weight_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "observed_contribution_pct": {"type": "number"}, "total_return_pct": {"type": ["number", "null"]},
    "groups": {
      "type": "object", "properties": {
        "industry": {"type": "array", "items": {"$ref": "#/$defs/group"}},
        "market": {"type": "array", "items": {"$ref": "#/$defs/group"}}
      }, "additionalProperties": false
    },
    "benchmark": {"type": "object", "required": ["benchmark_return_pct", "excess_return_pct", "status"], "properties": {"benchmark_return_pct": {"type": ["number", "null"]}, "excess_return_pct": {"type": ["number", "null"]}, "status": {"type": "string"}}, "additionalProperties": false},
    "quality_status": {"enum": ["available", "degraded", "data_gap"]},
    "data_gap": {"type": "array", "items": {"type": "string"}}, "assumption_flags": {"type": "array", "items": {"type": "string"}}, "generated_at": {"type": "string"}
  },
  "additionalProperties": false
}
