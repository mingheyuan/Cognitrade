{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verdict", "overall_verdict", "findings", "strengths", "weaknesses", "follow_up"],
  "properties": {
    "verdict": {"type": "string"},
    "overall_verdict": {"type": "string"},
    "findings": {"type": "array"},
    "strengths": {"type": "array"},
    "weaknesses": {"type": "array"},
    "follow_up": {"type": "array"},
    "review_target_run_id": {"type": ["string", "null"]},
    "review_target_artifact_ids": {"type": "array"},
    "review_target_found": {"type": "boolean"},
    "target_thesis": {"type": "array"},
    "evidence_comparison": {"type": "object"}
  }
}
