{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "methodology_version",
    "profile",
    "results",
    "confidence",
    "risk_flags"
  ],
  "properties": {
    "methodology_version": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "results": {
      "type": "array"
    },
    "status": {"type": "string"},
    "assumption_flags": {"type": "array", "items": {"type": "string"}},
    "summary": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_reviewed": {"type": "boolean"},
    "quality_status": {"type": "string"},
    "data_gap": {"type": "array", "items": {"type": "string"}},
    "qualitative_deep_dive": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["dimension_id", "evidence", "associations", "conclusion"],
        "properties": {
          "dimension_id": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "associations": {"type": "array", "items": {"type": "object"}},
          "conclusion": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "qualitative_agent_execution": {
      "type": "object",
      "required": ["required", "status", "agent_reviewed", "source_commit", "group_count", "completed_group_count", "evidence_count", "association_count", "errors"],
      "properties": {
        "required": {"type": "boolean"}, "status": {"type": "string"}, "agent_reviewed": {"type": "boolean"},
        "source_commit": {"type": "string"}, "group_count": {"type": "integer", "minimum": 0},
        "completed_group_count": {"type": "integer", "minimum": 0}, "evidence_count": {"type": "integer", "minimum": 0},
        "association_count": {"type": "integer", "minimum": 0}, "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
