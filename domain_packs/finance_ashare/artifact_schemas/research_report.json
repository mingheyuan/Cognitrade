{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "conclusion",
    "evidence",
    "risk",
    "follow_up"
  ],
  "properties": {
    "conclusion": {
      "type": "string"
    },
    "assessment": {
      "type": ["object", "null"]
    },
    "comparison": {
      "type": ["object", "null"]
    },
    "evidence": {
      "type": "array"
    },
    "risk": {
      "type": "array"
    },
    "follow_up": {
      "type": "array"
    },
    "methodologies": {
      "type": "array",
      "items": {"type": "object"}
    },
    "scorecard": {
      "type": ["object", "null"]
    },
    "screening_scorecard": {
      "type": ["object", "null"]
    },
    "uzi_profile": {
      "type": "object"
    },
    "valuation_model": {
      "type": "object"
    },
    "investor_panel_review": {
      "type": "object"
    },
    "risk_scan": {
      "type": "object"
    },
    "institutional_analysis": {
      "type": ["object", "null"]
    },
    "research_workflow": {
      "type": ["object", "null"]
    },
    "deep_analysis": {
      "type": ["object", "null"]
    },
    "uzi_dimension_coverage": {
      "type": ["object", "null"]
    },
    "uzi_data_pipeline": {
      "type": ["object", "null"]
    },
    "presentation_artifact_type": {
      "type": "string"
    },
    "holding_context": {
      "type": ["object", "null"],
      "required": [
        "parent_batch_id", "source_fund_run_id", "source_fund_artifact_id",
        "fund_code", "fund_name", "holding_rank", "symbol", "holding_source"
      ],
      "properties": {
        "parent_batch_id": {"type": "string"},
        "source_fund_run_id": {"type": "string"},
        "source_fund_artifact_id": {"type": "string"},
        "fund_code": {"type": "string"},
        "fund_name": {"type": "string"},
        "fund_type": {"type": ["string", "null"]},
        "holding_rank": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "security_name": {"type": "string"},
        "fund_weight_pct": {"type": ["number", "null"]},
        "target_security_weight_pct": {"type": ["number", "null"]},
        "holding_source": {"enum": ["direct_equity_disclosure", "target_etf_lookthrough"]},
        "disclosure_date": {"type": ["string", "null"]},
        "disclosure_age_days": {"type": ["integer", "null"], "minimum": 0},
        "stale_level": {"enum": ["current", "warning", "confirmation_required", "unknown"]},
        "disclaimer": {"type": "string"}
      },
      "additionalProperties": false
    },
    "fund_analysis": {
      "type": "object"
    },
    "quality_status": {
      "type": ["string", "null"]
    },
    "native_analysis_artifact_id": {"type": "string"},
    "report_allowed": {"type": "boolean"},
    "critical_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "delivery_type": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {"type": "object"}
    },
    "screening": {
      "type": "object"
    },
    "sector_analysis": {
      "type": "object"
    },
    "sector_heatmap": {
      "type": "array",
      "items": {"type": "object"}
    },
    "thesis_review": {
      "type": "object"
    },
    "review_summary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
