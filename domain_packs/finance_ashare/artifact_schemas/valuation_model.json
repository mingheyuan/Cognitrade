{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["dimension_id", "label", "score", "weight", "status", "evidence", "data_gap"],
      "properties": {
        "dimension_id": {"type": "string"}, "label": {"type": "string"},
        "score": {"type": ["number", "null"]}, "weight": {"type": "number"},
        "status": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "data_gap": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["model", "methodology_version", "symbol", "status", "fair_value", "market_price", "margin_of_safety", "assumptions", "sensitivity", "verdict", "confidence", "warnings", "data_gap", "assumption_flags", "field_sources", "methodology_log", "comps"],
      "properties": {
        "model": {"type": "string"}, "methodology_version": {"type": "string"}, "symbol": {"type": "string"},
        "status": {"type": "string"}, "fair_value": {"type": ["number", "null"]},
        "market_price": {"type": ["number", "null"]}, "margin_of_safety": {"type": ["number", "null"]},
        "assumptions": {
          "type": "object",
          "properties": {
            "wacc": {"type": "number"}, "terminal_growth": {"type": "number"},
            "stage_one_growth": {"type": "number"}, "stage_two_growth": {"type": "number"},
            "forecast_years": {"type": "integer"}, "risk_free_rate": {"type": "number"},
            "equity_risk_premium": {"type": "number"}, "beta": {"type": "number"},
            "tax_rate": {"type": "number"}, "target_debt_ratio": {"type": "number"},
            "cost_of_equity": {"type": "number"}, "after_tax_cost_of_debt": {"type": "number"},
            "total_debt_yi": {"type": ["number", "null"]}, "cash_yi": {"type": ["number", "null"]}
          },
          "additionalProperties": false
        },
        "sensitivity": {
          "type": "array",
          "items": {
            "type": "object", "required": ["wacc", "terminal_growth", "fair_value"],
            "properties": {"wacc": {"type": "number"}, "terminal_growth": {"type": "number"}, "fair_value": {"type": ["number", "null"]}},
            "additionalProperties": false
          }
        },
        "verdict": {"type": "string"}, "confidence": {"type": "number"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "data_gap": {"type": "array", "items": {"type": "string"}},
        "assumption_flags": {"type": "array", "items": {"type": "string"}},
        "field_sources": {"type": "object", "additionalProperties": {"type": "string"}, "x-business-extensible": true},
        "methodology_log": {"type": "array", "items": {"type": "string"}},
        "comps": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["method", "status", "relative_view", "peer_count", "warnings", "methodology_log"],
              "properties": {
                "method": {"type": "string"}, "status": {"type": "string"}, "relative_view": {"type": "string"},
                "peer_count": {"type": "integer"},
                "peer_medians": {"type": "object", "properties": {"pe": {"type": ["number", "null"]}, "pb": {"type": ["number", "null"]}}, "additionalProperties": false},
                "target": {"type": "object", "properties": {"pe": {"type": ["number", "null"]}, "pb": {"type": ["number", "null"]}}, "additionalProperties": false},
                "score_gap_vs_peer_median": {"type": ["number", "null"]}, "confidence": {"type": "number"},
                "warnings": {"type": "array", "items": {"type": "string"}},
                "methodology_log": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["methodology_version", "profile", "models", "primary_symbol", "methodologies"],
  "properties": {
    "methodology_version": {"type": "string"}, "profile": {"type": "string"},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "primary_symbol": {"type": ["string", "null"]},
    "methodologies": {"type": "array", "items": {"type": "string"}},
    "dimensions": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/dimension"}}, "x-business-extensible": true},
    "quality_status": {"type": "string"},
    "method_input_contract": {"type": "object", "x-business-extensible": true}
  },
  "additionalProperties": false
}
