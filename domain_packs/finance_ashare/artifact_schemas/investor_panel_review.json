{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "name", "weight", "msg"],
      "properties": {"rule_id": {"type": "string"}, "name": {"type": "string"}, "weight": {"type": "integer"}, "msg": {"type": "string"}},
      "additionalProperties": false
    },
    "vote": {
      "type": "object",
      "required": ["symbol", "investor_id", "perspective_id", "perspective_label", "investor_name_en", "methodology_source", "avatar_seed", "tier", "school", "required_dimensions", "signal", "score", "confidence", "uzi_confidence", "reasoning", "headline", "pass_rules", "fail_rules", "pass_count", "fail_count", "weight_pass", "weight_total", "rule_engine_version", "skip_reason", "time_horizon", "position_sizing", "what_would_change_my_mind", "checks", "is_methodology_perspective", "is_real_person_advice", "rule_mode"],
      "properties": {
        "symbol": {"type": "string"}, "investor_id": {"type": "string"}, "perspective_id": {"type": "string"},
        "perspective_label": {"type": "string"},
        "investor_name_en": {"type": ["string", "null"]},
        "methodology_source": {"type": ["string", "null"]},
        "avatar_seed": {"type": ["string", "null"]},
        "tier": {"type": ["string", "null"]},
        "school": {"type": "string"},
        "required_dimensions": {"type": "array", "items": {"type": "string"}},
        "signal": {"type": "string"}, "score": {"type": "number"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "uzi_confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "reasoning": {"type": "string"}, "headline": {"type": "string"},
        "pass_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "fail_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "pass_count": {"type": "integer"}, "fail_count": {"type": "integer"},
        "weight_pass": {"type": "integer"}, "weight_total": {"type": "integer"}, "rule_engine_version": {"type": "string"},
        "skip_reason": {"type": ["string", "null"]},
        "time_horizon": {"type": ["string", "null"]},
        "position_sizing": {"type": ["string", "null"]},
        "what_would_change_my_mind": {"type": ["string", "null"]},
        "checks": {
          "type": "array", "items": {"type": "object", "required": ["dimension", "status", "feature_names"], "properties": {"dimension": {"type": "string"}, "status": {"type": "string"}, "feature_names": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
        },
        "is_methodology_perspective": {"type": "boolean"}, "is_real_person_advice": {"type": "boolean"}, "rule_mode": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["methodology_version", "profile", "scope", "panel_version", "votes", "distribution", "disagreement", "confidence", "risk_flags"],
  "properties": {
    "methodology_version": {"type": "string"}, "profile": {"type": "string"}, "scope": {"type": "string"}, "panel_version": {"type": "string"},
    "source_commit": {"type": "string"}, "registered_seat_count": {"type": "integer", "minimum": 0}, "rule_mode": {"type": "string"},
    "method_input_contract": {"type": "object", "x-business-extensible": true},
    "votes": {"type": "array", "items": {"$ref": "#/$defs/vote"}},
    "distribution": {"type": "object", "properties": {"bullish": {"type": "integer"}, "bearish": {"type": "integer"}, "neutral": {"type": "integer"}, "skip": {"type": "integer"}}, "additionalProperties": false},
    "average_score": {"type": ["number", "null"]}, "evaluated_rule_count": {"type": "integer", "minimum": 0}, "skipped_seat_count": {"type": "integer", "minimum": 0},
    "quality_status": {"type": "string"}, "data_gap": {"type": "array", "items": {"type": "string"}},
    "disagreement": {"type": "object", "required": ["exists", "summary"], "properties": {"exists": {"type": "boolean"}, "summary": {"type": "string"}}, "additionalProperties": false},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "risk_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
