{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["methodology_version", "profile", "scope", "panel_version", "votes", "distribution", "disagreement", "confidence", "risk_flags"],
  "properties": {
    "methodology_version": {"type": "string"},
    "profile": {"type": "string"},
    "scope": {"type": "string"},
    "panel_version": {"type": "string"},
    "votes": {"type": "array", "items": {"type": "object"}},
    "distribution": {"type": "object"},
    "average_score": {"type": ["number", "null"]},
    "disagreement": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_flags": {"type": "array", "items": {"type": "string"}}
  }
}
