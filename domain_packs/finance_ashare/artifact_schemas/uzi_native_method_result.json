{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "native_result": {
      "type": "object",
      "x-business-extensible": true,
      "additionalProperties": true
    },
    "result_row": {
      "type": "object",
      "required": ["symbol", "result", "data_gap"],
      "properties": {
        "symbol": {"type": ["string", "null"]},
        "result": {
          "anyOf": [
            {"$ref": "#/$defs/native_result"},
            {"type": "null"}
          ]
        },
        "data_gap": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "method_id",
    "source_commit",
    "implementation",
    "results",
    "quality_status",
    "data_gap",
    "assumptions"
  ],
  "properties": {
    "method_id": {
      "enum": [
        "dcf", "comps", "three_statement", "quick_lbo", "accretion_dilution",
        "initiation_report", "earnings_review", "catalyst_calendar", "thesis_tracker",
        "morning_note", "quantitative_screen", "sector_review", "ic_memo", "porter_bcg",
        "dd_checklist", "unit_economics", "value_creation_plan", "portfolio_rebalance",
        "ai_readiness", "earnings_preview", "model_update", "returns_attribution",
        "holding_rebalance"
      ]
    },
    "source_commit": {"const": "b004d7a988ca53a4805bf36784af091fa1209f22"},
    "implementation": {"const": "vendored_uzi_3_9_2_pure_function"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result_row"}},
    "quality_status": {"enum": ["available", "degraded", "data_gap"]},
    "data_gap": {"type": "array", "items": {"type": "string"}},
    "assumptions": {
      "type": "object",
      "x-business-extensible": true,
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
