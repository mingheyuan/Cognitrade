{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_commit",
    "methodology_version",
    "profile",
    "results",
    "critical_count",
    "warning_count",
    "report_allowed",
    "quality_status",
    "recovery_history"
  ],
  "properties": {
    "source_commit": {"type": "string"},
    "methodology_version": {"type": "string"},
    "profile": {"enum": ["lite", "medium", "deep"]},
    "agent_workflow_mode": {"enum": ["full", "profile"]},
    "school": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", null]},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "x-business-extensible": true
      }
    },
    "critical_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "report_allowed": {"type": "boolean"},
    "quality_status": {"enum": ["available", "degraded", "quality_gate_blocked"]},
    "recovery_history": {
      "type": "array",
      "items": {
        "type": "object",
        "x-business-extensible": true
      }
    },
    "recovery": {
      "type": "object",
      "required": ["schema_version", "kind", "action", "retryable", "input_hash", "reason_codes"],
      "properties": {
        "schema_version": {"const": "uzi-recovery-v1"},
        "kind": {"type": "string"},
        "action": {"type": "string"},
        "retryable": {"type": "boolean"},
        "manual_retryable": {"type": "boolean"},
        "input_hash": {"type": "string"},
        "stages": {"type": "array", "items": {"type": "string"}},
        "dimensions": {"type": "array", "items": {"type": "string"}},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "repairable_stages": {"type": "array", "items": {"type": "string"}},
        "output_dimensions": {"type": "array", "items": {"type": "string"}},
        "exhausted_stages": {"type": "array", "items": {"type": "string"}},
        "failure_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "kind", "error_type"],
            "properties": {
              "stage": {"type": "string"},
              "kind": {"enum": ["agent_content_invalid", "source_gap", "pipeline_failure", "llm_cancelled", "llm_stage_deadline", "llm_queue_timeout", "llm_transport_timeout", "llm_provider_unavailable"]},
              "error_type": {"type": "string"},
              "provider_status_code": {"type": "integer", "minimum": 100, "maximum": 599},
              "provider_error_code": {"type": "string"},
              "provider_error_type": {"type": "string"},
              "provider_request_id": {"type": "string"},
              "retry_after_seconds": {"type": "number", "minimum": 0},
              "provider_retryable": {"type": "boolean"},
              "validation_fields": {"type": "array", "items": {"type": "string"}},
              "validation_codes": {"type": "array", "items": {"type": "string"}},
              "validation_reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field", "code"],
                  "properties": {
                    "field": {"type": "string"},
                    "code": {"enum": ["qualitative_evidence_url_invalid", "qualitative_unknown_gap_not_disclosed", "qualitative_factual_evidence_incomplete", "qualitative_dimension_membership_mismatch", "qualitative_repeated_finding", "qualitative_citations_incomplete", "qualitative_ungrounded_url", "qualitative_archive_binding_unknown", "qualitative_archive_binding_conflict", "qualitative_archive_binding_ambiguous", "qualitative_archive_binding_date_missing", "roleplay_override_reason_missing", "roleplay_rationale_grounding_missing"]},
                    "missing_fields": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 3,
                      "uniqueItems": true,
                      "items": {"enum": ["url", "retrieved_at", "finding"]}
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "holding_context": {"type": ["object", "null"], "x-business-extensible": true}
  },
  "additionalProperties": false
}
