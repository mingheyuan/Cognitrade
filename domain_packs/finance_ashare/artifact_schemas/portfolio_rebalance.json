{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["methodology_version", "method", "quality_status", "data_gap", "assumption_flags", "generated_at"],
  "properties": {
    "methodology_version": {"type": "string"}, "method": {"const": "portfolio_rebalance"},
    "target_mode": {"type": "string"}, "drift_threshold_pp": {"type": "number", "minimum": 0},
    "asset_classes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["asset_class", "current_weight", "target_weight", "drift_pp", "breached", "action", "suggested_value_change"],
        "properties": {
          "asset_class": {"type": "string"}, "current_weight": {"type": "number"}, "target_weight": {"type": "number"},
          "drift_pp": {"type": "number"}, "breached": {"type": "boolean"}, "action": {"type": "string"},
          "suggested_value_change": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "portfolio_value": {"type": ["number", "null"]},
    "quality_status": {"enum": ["available", "degraded", "assumption_only", "data_gap"]},
    "data_gap": {"type": "array", "items": {"type": "string"}}, "assumption_flags": {"type": "array", "items": {"type": "string"}}, "generated_at": {"type": "string"}
  },
  "additionalProperties": false
}
