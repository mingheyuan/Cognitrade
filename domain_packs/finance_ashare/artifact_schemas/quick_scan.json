{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "name", "weight", "msg"],
      "properties": {
        "rule_id": {"type": "string"},
        "name": {"type": "string"},
        "weight": {"type": "integer"},
        "msg": {"type": "string"}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["dimension", "status", "feature_names"],
      "properties": {
        "dimension": {"type": "string"},
        "status": {"type": "string"},
        "feature_names": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "vote": {
      "type": "object",
      "required": ["symbol", "investor_id", "perspective_id", "perspective_label", "investor_name_en", "methodology_source", "avatar_seed", "tier", "school", "required_dimensions", "signal", "score", "confidence", "uzi_confidence", "reasoning", "headline", "pass_rules", "fail_rules", "pass_count", "fail_count", "skipped_rule_count", "weight_pass", "weight_total", "rule_engine_version", "skip_reason", "time_horizon", "position_sizing", "what_would_change_my_mind", "checks", "is_methodology_perspective", "is_real_person_advice", "rule_mode"],
      "properties": {
        "symbol": {"type": "string"},
        "investor_id": {"type": "string"},
        "perspective_id": {"type": "string"},
        "perspective_label": {"type": "string"},
        "investor_name_en": {"type": ["string", "null"]},
        "methodology_source": {"type": ["string", "null"]},
        "avatar_seed": {"type": ["string", "null"]},
        "tier": {"type": ["string", "null"]},
        "school": {"type": "string"},
        "required_dimensions": {"type": "array", "items": {"type": "string"}},
        "signal": {"type": "string"},
        "score": {"type": "number"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uzi_confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "reasoning": {"type": "string"},
        "headline": {"type": "string"},
        "pass_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "fail_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "pass_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0},
        "skipped_rule_count": {"type": "integer", "minimum": 0},
        "weight_pass": {"type": "integer", "minimum": 0},
        "weight_total": {"type": "integer", "minimum": 0},
        "rule_engine_version": {"type": "string"},
        "skip_reason": {"type": ["string", "null"]},
        "time_horizon": {"type": ["string", "null"]},
        "position_sizing": {"type": ["string", "null"]},
        "what_would_change_my_mind": {"type": ["string", "null"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "is_methodology_perspective": {"type": "boolean"},
        "is_real_person_advice": {"type": "boolean"},
        "rule_mode": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["command", "methodology_version", "source_commit", "symbol", "required_dimensions", "dimension_status", "investor_ids", "verdict", "aggregate_score", "votes", "trap_level", "trap_signals_hit", "risks", "markdown", "output_format", "html_generated", "quality_status", "confidence", "data_gap", "risk_flags"],
  "properties": {
    "command": {"const": "quick-scan"},
    "methodology_version": {"type": "string"},
    "source_commit": {"type": "string"},
    "symbol": {"type": ["string", "null"]},
    "required_dimensions": {"type": "array", "prefixItems": [{"const": "1_financials"}, {"const": "2_kline"}, {"const": "10_valuation"}, {"const": "18_trap"}], "items": false},
    "dimension_status": {
      "type": "object",
      "required": ["1_financials", "2_kline", "10_valuation", "18_trap"],
      "properties": {
        "1_financials": {"type": "string"},
        "2_kline": {"type": "string"},
        "10_valuation": {"type": "string"},
        "18_trap": {"type": "string"}
      },
      "additionalProperties": false
    },
    "investor_ids": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string"}},
    "verdict": {"type": "string"},
    "aggregate_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "votes": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/vote"}},
    "trap_level": {"type": ["string", "null"]},
    "trap_signals_hit": {"type": ["integer", "null"], "minimum": 0},
    "risks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
    "markdown": {"type": "string"},
    "output_format": {"const": "markdown"},
    "html_generated": {"const": false},
    "quality_status": {"enum": ["available", "degraded", "data_gap"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "data_gap": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
