{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["methodology_version", "profile", "dimension_count", "coverage", "confidence", "risk_flags"],
  "properties": {
    "methodology_version": {"type": "string"},
    "profile": {"type": "string"},
    "dimension_count": {"type": "integer", "minimum": 1},
    "coverage": {"type": "object"},
    "available_count": {"type": "integer", "minimum": 0},
    "missing_count": {"type": "integer", "minimum": 0},
    "data_gap": {"type": "array"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_flags": {"type": "array", "items": {"type": "string"}}
  }
}
