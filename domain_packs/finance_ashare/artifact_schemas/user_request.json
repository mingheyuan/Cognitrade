{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "query"
  ],
  "properties": {
    "query": {"type": "string"},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "fund_codes": {"type": "array", "items": {"type": "string"}},
    "fund_category": {"type": ["string", "null"]},
    "portfolio_holdings": {"type": "array", "items": {"type": "object"}},
    "benchmark_return": {"type": ["number", "null"]},
    "rebalance_targets": {"type": "object"},
    "asset_class_targets": {"type": "object"},
    "drift_threshold": {"type": ["number", "null"]},
    "fee_model": {"type": "object"},
    "requested_methods": {"type": "array", "items": {"type": "string"}},
    "model_updates": {"type": "object"},
    "method_assumptions": {"type": "object"},
    "sector": {"type": ["string", "null"]},
    "source_records": {"type": "array", "items": {"type": "object"}},
    "snapshots": {"type": "array", "items": {"type": "object"}},
    "source_refs": {"type": "array", "items": {"type": "object"}},
    "market_data_bundle": {"type": "object"},
    "report_data_manifest": {"type": "object"},
    "holding_context": {
      "type": ["object", "null"],
      "required": [
        "parent_batch_id", "source_fund_run_id", "source_fund_artifact_id",
        "fund_code", "fund_name", "holding_rank", "symbol", "holding_source"
      ],
      "properties": {
        "parent_batch_id": {"type": "string"},
        "source_fund_run_id": {"type": "string"},
        "source_fund_artifact_id": {"type": "string"},
        "fund_code": {"type": "string"},
        "fund_name": {"type": "string"},
        "fund_type": {"type": ["string", "null"]},
        "holding_rank": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string"},
        "security_name": {"type": "string"},
        "fund_weight_pct": {"type": ["number", "null"]},
        "target_security_weight_pct": {"type": ["number", "null"]},
        "holding_source": {"enum": ["direct_equity_disclosure", "target_etf_lookthrough"]},
        "disclosure_date": {"type": ["string", "null"]},
        "disclosure_age_days": {"type": ["integer", "null"], "minimum": 0},
        "stale_level": {"enum": ["current", "warning", "confirmation_required", "unknown"]},
        "disclaimer": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
