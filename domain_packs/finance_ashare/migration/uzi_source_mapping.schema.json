{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "contract",
    "fetchers",
    "source_registry",
    "profiles",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "3"},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "version", "license", "license_sha256", "vendored_root"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "version": {"const": "3.9.2"},
        "license": {"const": "MIT"},
        "license_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "vendored_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "contract": {"type": "object", "minProperties": 1},
    "defaults": {
      "type": "object",
      "required": ["source_commit", "migration_status", "result_equivalence", "invocation_acceptance"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "migration_status": {"const": "source_parity"},
        "result_equivalence": {"const": "exact"},
        "invocation_acceptance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "fetchers": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {"$ref": "#/$defs/fetcher"}
    },
    "source_registry": {
      "type": "object",
      "required": ["source_path", "target_paths", "source_count", "result_equivalence", "acceptance"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "target_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_count": {"const": 73},
        "result_equivalence": {"const": "exact"},
        "acceptance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "required": ["lite", "medium", "deep"],
      "properties": {
        "lite": {"$ref": "#/$defs/profile"},
        "medium": {"$ref": "#/$defs/profile"},
        "deep": {"$ref": "#/$defs/profile"}
      },
      "additionalProperties": false
    },
    "verification": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "fetcher": {
      "type": "object",
      "required": [
        "source_id",
        "source_path",
        "target_skill",
        "source_commit",
        "migration_status",
        "result_equivalence",
        "invocation_acceptance"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "target_skill": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "migration_status": {"const": "source_parity"},
        "result_equivalence": {"const": "exact"},
        "invocation_acceptance": {"type": "string", "minLength": 1},
        "sensitive_source_policy": {"type": "object"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["source_dimensions", "panel_seats"],
      "properties": {
        "source_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "panel_seats": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
