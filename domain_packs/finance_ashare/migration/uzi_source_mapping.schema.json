{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "contract",
    "vendored_methodology_resources",
    "fetchers",
    "source_registry",
    "profiles",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "3"},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "version", "license", "license_sha256", "vendored_root"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "version": {"const": "3.9.4"},
        "license": {"const": "MIT"},
        "license_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "vendored_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "contract": {"type": "object", "minProperties": 1},
    "vendored_methodology_resources": {"$ref": "#/$defs/methodology_resources"},
    "defaults": {
      "type": "object",
      "required": ["source_commit", "migration_status", "result_equivalence", "invocation_acceptance"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "migration_status": {"const": "source_parity"},
        "result_equivalence": {"const": "exact"},
        "invocation_acceptance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "fetchers": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {"$ref": "#/$defs/fetcher"}
    },
    "source_registry": {
      "type": "object",
      "required": ["source_path", "target_paths", "source_count", "result_equivalence", "acceptance"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "target_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_count": {"const": 73},
        "result_equivalence": {"const": "exact"},
        "acceptance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "required": ["lite", "medium", "deep"],
      "properties": {
        "lite": {"$ref": "#/$defs/profile"},
        "medium": {"$ref": "#/$defs/profile"},
        "deep": {"$ref": "#/$defs/profile"}
      },
      "additionalProperties": false
    },
    "verification": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "methodology_resources": {
      "type": "object",
      "required": [
        "standalone_skill_roots",
        "canonical_file_count",
        "path_sensitive_sha256",
        "consumption",
        "deep_analysis_relocations",
        "host_boundary"
      ],
      "properties": {
        "standalone_skill_roots": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "canonical_file_count": {"const": 17},
        "path_sensitive_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "consumption": {"const": "reference_only_static_contracts"},
        "deep_analysis_relocations": {
          "type": "object",
          "required": [
            "skills/deep-analysis/SKILL.md",
            "skills/deep-analysis/references",
            "skills/deep-analysis/personas",
            "skills/deep-analysis/scripts",
            "skills/deep-analysis/assets"
          ],
          "properties": {
            "skills/deep-analysis/SKILL.md": {"const": "skill/SKILL.md"},
            "skills/deep-analysis/references": {"const": "skill/references"},
            "skills/deep-analysis/personas": {"const": "skill/personas"},
            "skills/deep-analysis/scripts": {"const": "scripts"},
            "skills/deep-analysis/assets": {"const": "assets"}
          },
          "additionalProperties": false
        },
        "host_boundary": {
          "type": "object",
          "required": [
            "upstream_root_router",
            "upstream_cli_entrypoints",
            "plugin_installers_and_hooks",
            "upstream_tests"
          ],
          "properties": {
            "upstream_root_router": {"const": "replaced_by_agent_os"},
            "upstream_cli_entrypoints": {"const": "replaced_by_agent_os"},
            "plugin_installers_and_hooks": {"const": "distribution_only"},
            "upstream_tests": {"const": "pinned_checkout_ci_surface"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fetcher": {
      "type": "object",
      "required": [
        "source_id",
        "source_path",
        "target_skill",
        "source_commit",
        "migration_status",
        "result_equivalence",
        "invocation_acceptance"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "target_skill": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "migration_status": {"const": "source_parity"},
        "result_equivalence": {"const": "exact"},
        "invocation_acceptance": {"type": "string", "minLength": 1},
        "sensitive_source_policy": {"type": "object"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["source_dimensions", "bonus_collectors", "panel_seats"],
      "properties": {
        "source_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bonus_collectors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "panel_seats": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
