{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "source", "fetchers", "profiles", "panel", "derived_methods"],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "methodology_version", "version_file", "version_file_sha256", "license", "license_file", "license_sha256", "replay_fixtures", "replay_fixture_sha256"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "minLength": 7},
        "methodology_version": {"type": "string", "minLength": 1},
        "version_file": {"type": "string", "minLength": 1},
        "version_file_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "license": {"type": "string", "minLength": 1},
        "license_file": {"type": "string", "minLength": 1},
        "license_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "replay_fixtures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "replay_fixture_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      },
      "additionalProperties": true
    },
    "fetchers": {
      "type": "array",
      "minItems": 22,
      "items": {"$ref": "#/$defs/mapping_entry"}
    },
    "profiles": {
      "type": "object",
      "required": ["lite", "medium", "deep"],
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "panel": {
      "type": "object",
      "required": ["source_path", "source_commit", "registry_version", "provider", "target_artifact_type", "field_mapping", "quality_policy", "migration_status", "result_equivalence", "baseline_fixture", "profile_seats", "member_ids"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 7},
        "registry_version": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "target_artifact_type": {"type": "string", "minLength": 1},
        "field_mapping": {"type": "object", "minProperties": 1},
        "quality_policy": {"type": "object", "minProperties": 1},
        "migration_status": {"$ref": "#/$defs/migration_status"},
        "result_equivalence": {"$ref": "#/$defs/result_equivalence"},
        "baseline_fixture": {"type": "string", "minLength": 1},
        "profile_seats": {"type": "object", "required": ["lite", "medium", "deep"]},
        "member_ids": {"type": "array", "minItems": 66, "maxItems": 66, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "derived_methods": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mapping_entry"}
    }
  },
  "$defs": {
    "migration_status": {
      "type": "string",
      "enum": ["planned", "pack_native", "pack_native_with_provider_gap", "equivalent", "not_equivalent"]
    },
    "result_equivalence": {
      "type": "string",
      "enum": ["exact", "numeric_tolerance", "semantic", "not_equivalent"]
    },
    "mapping_entry": {
      "type": "object",
      "required": ["source_id", "source_path", "source_commit", "provider", "field_mapping", "quality_policy", "migration_status", "result_equivalence", "baseline_fixture"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "minLength": 7},
        "provider": {"type": "string", "minLength": 1},
        "field_mapping": {"type": "object", "minProperties": 1},
        "quality_policy": {"type": "object", "minProperties": 1},
        "migration_status": {"$ref": "#/$defs/migration_status"},
        "result_equivalence": {"$ref": "#/$defs/result_equivalence"},
        "baseline_fixture": {"type": "string", "minLength": 1},
        "target_artifact_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": ["source_dimensions", "panel_seats"],
      "properties": {
        "source_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "panel_seats": {"type": "integer", "minimum": 1},
        "methodology_capabilities": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
